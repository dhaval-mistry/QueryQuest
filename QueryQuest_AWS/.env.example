# AWS project account: aws login --profile queryquest --region us-east-2
# Then uncomment AWS_PROFILE below. Boto3 uses the temporary login credentials.
AWS_REGION=us-east-2
# AWS_PROFILE=queryquest
# A Bedrock-only bearer token cannot authorize AgentCore Web Search or SES.
# Alternative to a profile: set the following from your AWS credentials locally.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # Required only for temporary session credentials.

# Bedrock Converse model/inference profile, Claude on Bedrock, not a Mantle GPT model ID.
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
# Optional overrides:
# BEDROCK_PLANNER_MODEL=us.anthropic.claude-sonnet-4-6
# BEDROCK_WRITER_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_MAX_TOKENS=4096

HOW_MANY_SEARCHES=5
MAX_SEARCHES_PER_RUN=2
AWS_SEARCH_REGION=us-east-2
AWS_SEARCH_MAX_RESULTS=5

# Optional Amazon SES delivery. Verify the sender identity in this region.
AWS_SES_REGION=us-east-2
EMAIL_ADDRESS=
EMAIL_TO=
