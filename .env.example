# AWS configuration
AWS_REGION=

# Your existing AWS Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=ABSK

# Model for our Planner Agent
#BEDROCK_MODEL=openai.gpt-oss-20b
BEDROCK_MODEL=openai.gpt-oss-120b
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/v1
DEFAULT_MODEL_NAME=gpt-5.4-mini
WRITER_MODEL_NAME=gpt-5.4-mini
MAX_SEARCHES_PER_RUN=2

# Email configuration
EMAIL_APP_PASSWORD=
EMAIL_ADDRESS=
EMAIL_SMTP_SERVER=smtp.gmail.com

# Do not export prompt/response content to traces.
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false

# OpenAI API key for tracing
OpenAI_API_KEY=sk-proj