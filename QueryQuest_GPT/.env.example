# OpenAI-hosted GPT models and OpenAI WebSearchTool.
OPENAI_API_KEY=
DEFAULT_MODEL_NAME=gpt-5.4-mini
WRITER_MODEL_NAME=gpt-5.4-mini
HOW_MANY_SEARCHES=5
MAX_SEARCHES_PER_RUN=2
OPENAI_AGENTS_TRACING_DISABLED=true
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false

# Optional Gmail SMTP delivery.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_TO=
